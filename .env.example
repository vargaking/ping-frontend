# Public (client-exposed) environment variables for ping-frontend.
# Copy this file to `.env` and adjust for your environment.
# Anything prefixed with PUBLIC_ is inlined into the client bundle by SvelteKit.

# WebSocket endpoint. A leading "/" is resolved against the current host/protocol
# at runtime (e.g. "/ws" -> "wss://<host>/ws"); an absolute "wss://..." is used as-is.
PUBLIC_WS_URL="/ws"

# Base URL for REST requests. Leave empty to use same-origin relative paths.
PUBLIC_BASE_URL=""
